{
  "$schema": "design-tokens (informal)",
  "name": "Anthropic-inspired presentation system",
  "version": "1.0.0",
  "source": "16 screenshots of a Code w/ Claude conference talk (2026-10-12 capture); colors sampled from pixels (median 7x7). \"estimated\" = not cleanly sampleable (anti-aliased/small).",
  "color": {
    "paper": {
      "value": "#eeeee5",
      "confidence": "measured",
      "usage": "Default slide/page canvas. Warm off-white with a faint green cast. Never pure white."
    },
    "surface": {
      "value": "#f3f4eb",
      "confidence": "measured",
      "usage": "Cards sitting on paper (flow steps, pillars, quote cards on sage)."
    },
    "surface-raised": {
      "value": "#f8f9f2",
      "confidence": "measured",
      "usage": "Floating UI: windows, modals, agent/session cards. Lightest allowed neutral."
    },
    "stone-100": {
      "value": "#e7e8dc",
      "confidence": "measured",
      "usage": "Secondary half of a split slide; large calm region."
    },
    "stone-200": {
      "value": "#dcddd1",
      "confidence": "measured",
      "usage": "Neutral node/panel fill (diagram boxes, comparison panels)."
    },
    "stone-300": {
      "value": "#d0d1c6",
      "confidence": "measured",
      "usage": "Deeper node fill; the \"process\" box inside a diagram."
    },
    "stone-400": {
      "value": "#b8b8b1",
      "confidence": "measured",
      "usage": "Muted pill/handle, timeline axis (#b8b6ad measured)."
    },
    "stone-500": {
      "value": "#a4a397",
      "confidence": "measured",
      "usage": "Connector lines, dashed region borders."
    },
    "stone-600": {
      "value": "#78796f",
      "confidence": "measured",
      "usage": "Dark neutral tag (e.g. read-only), dashed vertical guides."
    },
    "ink": {
      "value": "#1b1b19",
      "confidence": "measured",
      "usage": "Primary text and solid black motif shapes. Never #000."
    },
    "ink-soft": {
      "value": "#414238",
      "confidence": "estimated",
      "usage": "Secondary headings / labels on light fills."
    },
    "body": {
      "value": "#55564d",
      "confidence": "estimated",
      "usage": "Paragraph text inside tinted cards."
    },
    "muted": {
      "value": "#6e6f66",
      "confidence": "measured",
      "usage": "Supporting copy under headings; mono code lines on cards."
    },
    "clay": {
      "value": "#d77f60",
      "confidence": "measured",
      "usage": "THE accent. Terracotta. Dots, session tiles, primary pills, highlights. One per slide cluster, not a fill for whole slides."
    },
    "clay-tint": {
      "value": "#efd7c8",
      "confidence": "measured",
      "usage": "Peach card fill."
    },
    "sage": {
      "value": "#bed3ca",
      "confidence": "measured",
      "usage": "Hero/media slides background, highlighted card, \"input\" tiles."
    },
    "sage-soft": {
      "value": "#c4d9d2",
      "confidence": "measured",
      "usage": "Cover background (slightly lighter sage)."
    },
    "lavender": {
      "value": "#cbccd8",
      "confidence": "measured",
      "usage": "Second tint: structure / transformed-state boxes."
    },
    "sky": {
      "value": "#6fa0cb",
      "confidence": "measured",
      "usage": "Product-UI demo backgrounds only."
    },
    "hairline": {
      "value": "#e2e3d9",
      "confidence": "measured",
      "usage": "1px card border on paper."
    },
    "divider": {
      "value": "#dcddd1",
      "confidence": "measured",
      "usage": "Vertical column dividers (pillars), split-slide seam."
    },
    "status-ok-bg": {
      "value": "#e1ecd9",
      "confidence": "estimated",
      "usage": "Status chip \"Active\"."
    },
    "status-ok-fg": {
      "value": "#4f7a3d",
      "confidence": "estimated",
      "usage": ""
    },
    "status-info-bg": {
      "value": "#dfe8f0",
      "confidence": "estimated",
      "usage": "Status chip \"Running\"."
    },
    "status-info-fg": {
      "value": "#3f6a96",
      "confidence": "estimated",
      "usage": ""
    },
    "status-new-bg": {
      "value": "#e4e3ee",
      "confidence": "estimated",
      "usage": "Chip \"New\"."
    },
    "status-new-fg": {
      "value": "#5a5780",
      "confidence": "estimated",
      "usage": ""
    },
    "cream": {
      "value": "#f9faf5",
      "confidence": "measured",
      "usage": "Cut-paper shapes in illustrations (reference image 1). Lighter than surface-raised; illustrations only."
    },
    "ink-deep": {
      "value": "#141414",
      "confidence": "measured",
      "usage": "Ink of hand-drawn strokes and blots in illustrations (measured on keynote and graph references). UI text stays --ad-ink."
    },
    "clay-deep": {
      "value": "#cc785c",
      "confidence": "measured",
      "usage": "Deeper clay for illustration-card grounds (reference image 2). Never next to --ad-clay in the same cluster."
    },
    "tan": {
      "value": "#d4a27f",
      "confidence": "measured",
      "usage": "Illustration-card ground / peach paper (reference image 2). Illustration use only."
    },
    "beige": {
      "value": "#ebdabc",
      "confidence": "measured",
      "usage": "Illustration-card ground (tangle / thread). Illustration use only."
    },
    "warm-grey": {
      "value": "#bebfb9",
      "confidence": "measured",
      "usage": "Illustration-card ground and grey paper (reference image 2). Illustration use only."
    }
  },
  "font": {
    "serif": {
      "stack": "'Anthropic Serif','Tiempos Headline','Literata',Georgia,'Times New Roman',serif",
      "role": "Titles, card headings, callouts",
      "fallback_bundled": "Literata (OFL)"
    },
    "sans": {
      "stack": "'Anthropic Sans','Styrene B','Hanken Grotesk','Helvetica Neue',Arial,system-ui,sans-serif",
      "role": "Body, labels, UI",
      "fallback_bundled": "Hanken Grotesk (OFL, Vietnamese OK)"
    },
    "mono": {
      "stack": "'Anthropic Mono','JetBrains Mono',ui-monospace,'SFMono-Regular',Menlo,Consolas,monospace",
      "role": "Code, filenames, attributions",
      "fallback_bundled": "JetBrains Mono (OFL)"
    }
  },
  "type": {
    "display-cover": {
      "family": "serif",
      "size": 100,
      "weight": 500,
      "lh": 1.16,
      "ls": "-0.022em",
      "use": "Cover title only"
    },
    "title": {
      "family": "serif",
      "size": 84,
      "weight": 500,
      "lh": 1.02,
      "ls": "-0.022em",
      "use": "Every slide title; sentence case; max 2 lines (3 in split slides)"
    },
    "subtitle": {
      "family": "sans",
      "size": 40,
      "weight": 400,
      "lh": 1.28,
      "ls": "0",
      "use": "Muted line under a title (color muted)"
    },
    "card-title": {
      "family": "serif",
      "size": 42,
      "weight": 500,
      "lh": 1.15,
      "ls": "-0.01em",
      "use": "Pillar/card headings; keyword may be weight 700"
    },
    "callout": {
      "family": "serif",
      "size": 40,
      "weight": 400,
      "lh": 1.3,
      "ls": "0",
      "use": "Quote callout; key phrases weight 700"
    },
    "body-l": {
      "family": "sans",
      "size": 32,
      "weight": 400,
      "lh": 1.4,
      "ls": "0",
      "use": "Pillar descriptions, quote text"
    },
    "body": {
      "family": "sans",
      "size": 28,
      "weight": 400,
      "lh": 1.4,
      "ls": "0",
      "use": "Default slide paragraph / bullets"
    },
    "label": {
      "family": "sans",
      "size": 28,
      "weight": 600,
      "lh": 1.2,
      "ls": "0",
      "use": "Timeline labels, tile headings, captions (semibold)"
    },
    "caption": {
      "family": "sans",
      "size": 24,
      "weight": 400,
      "lh": 1.3,
      "ls": "0",
      "use": "Captions under diagram cards"
    },
    "mono-title": {
      "family": "mono",
      "size": 44,
      "weight": 400,
      "lh": 1.2,
      "ls": "0",
      "use": "File/command names as headings (CLAUDE.md, memory/)"
    },
    "mono": {
      "family": "mono",
      "size": 28,
      "weight": 400,
      "lh": 1.45,
      "ls": "0",
      "use": "Code lines, attribution, presenter role"
    },
    "mono-s": {
      "family": "mono",
      "size": 20,
      "weight": 400,
      "lh": 1.4,
      "ls": "0",
      "use": "UI labels inside session cards"
    }
  },
  "space": {
    "slide-x": 90,
    "slide-top": 64,
    "content-top": 255,
    "gap-card": 24,
    "gap-section": 56,
    "pad-card": 44,
    "pad-card-sm": 28
  },
  "radius": {
    "xs": 8,
    "sm": 14,
    "md": 22,
    "lg": 28,
    "xl": 44,
    "pill": 999
  },
  "shadow": {
    "float": "0 30px 80px -24px rgba(27,27,25,.28), 0 2px 6px rgba(27,27,25,.06)",
    "card": "0 1px 0 rgba(27,27,25,.04)",
    "window": "0 40px 90px -30px rgba(27,27,25,.35), 0 2px 8px rgba(27,27,25,.08)"
  },
  "stage": {
    "width": 1920,
    "height": 1080,
    "note": "Design every slide at 1920x1080 and scale the stage; reference captures were 1317x741 (x1.458)."
  }
}